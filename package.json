{
  "name": "copyright-censor",
  "version": "0.1.1",
  "description": "Realtime conservative copyright/trademark prompt censor with token-level spans. Not legal advice.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./blocklist.json": "./data/blocklist.json",
    "./catalog.meta.json": "./data/catalog.meta.json"
  },
  "bin": {
    "copyright-censor": "./bin/copyright-censor.js"
  },
  "files": [
    "src",
    "data",
    "bin",
    "demo",
    "scripts",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-reporter=spec test/*.test.js",
    "demo": "npx --yes serve -l 4173 .",
    "build-catalog": "python3 scripts/fetch_identifiers.py && node scripts/compile-catalog.js",
    "compile-catalog": "node scripts/compile-catalog.js"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "license": "MIT",
  "author": "Differential AI Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/difflabai/copyright-censor.git"
  },
  "bugs": {
    "url": "https://github.com/difflabai/copyright-censor/issues"
  },
  "homepage": "https://difflabai.github.io/copyright-censor/",
  "keywords": [
    "copyright",
    "trademark",
    "censor",
    "prompt",
    "filter",
    "music",
    "safety",
    "blocklist",
    "difflab"
  ]
}
